# The panel — PANEL_DOC Section 10.
#
# Copy this to .env, fill it in, then run:
#
#   php artisan key:generate
#   php artisan migrate
#   php artisan db:seed          # the only way to get an account — there is no sign-up page
#   php artisan panel:check      # says whether the rest of this file is right
#
# `panel:check` is the one to run after any change here. It asks every one of
# these settings a real question and names the ones that are wrong, rather than
# letting a wrong path surface halfway through creating a customer.

APP_NAME="Soran Panel"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://panel.soranstore.com

# English only — Section 9: the panel has one reader.
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# The panel's own database
# ---------------------------------------------------------------------------
# Its own schema, separate from every shop. This account needs rights over this
# database only — making shops' databases uses the separate account below.

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=soran_panel
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# No forgotten-password email exists, because MAIL_MAILER is `log` on this
# hosting and a link that never leaves the building is worse than no link.
# The authenticator is the way back in.
MAIL_MAILER=log

# ---------------------------------------------------------------------------
# The first operator
# ---------------------------------------------------------------------------
# Read by `db:seed`. Running it twice does not reset the password.

PANEL_ADMIN_NAME=Soran
PANEL_ADMIN_EMAIL=
PANEL_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# The seller's public key
# ---------------------------------------------------------------------------
# The PUBLIC half only, and the same key the shop system ships — if the two ever
# differ, the panel accepts a licence the customer's shop then rejects, and the
# customer is locked out by the act of renewing.
#
# LEAVE THIS COMMENTED OUT unless you have changed the shop system's key.
#
# Commented out, config/licence.php's committed default is used — the same key
# every shop ships. SET BUT EMPTY is not the same thing and is much worse: an
# empty value overrides the default, so the panel would hold no key, refuse
# every licence you paste as "not signed by your key", and give no hint why.
#
# The private key never comes near this server (Section 6). PANEL_PRIVATE_KEY_PATH
# below is only where YOUR copy of it lives, so the Renew screen prints the
# right command.

# LICENCE_PUBLIC_KEY=
# Single-quoted: a Windows path is full of backslashes, and inside DOUBLE
# quotes dotenv reads \s and \p as escape sequences, does not recognise them,
# and refuses the WHOLE file. That is not a bad value in one setting — it is
# `cp .env.example .env` failing, which is step 2 of DEPLOY.md.
PANEL_PRIVATE_KEY_PATH='C:\soran-keys\private.pem'

# ---------------------------------------------------------------------------
# Where shops live
# ---------------------------------------------------------------------------
# Section 4: document roots cannot leave public_html — cPanel was tested and
# silently made its own folder inside it, ignoring the path typed in. So a
# shop's private folder and its public folder are in different places.
#
# `shared_artisan` is the one codebase every shop reads (Section 3). The panel
# runs shop:provision through it.
#
# ON THE SERVER
#   PANEL_SHOPS_HOME=/home/soransto/shops
#   PANEL_SHOPS_PUBLIC=/home/soransto/public_html
#   PANEL_SHARED_ARTISAN=/home/soransto/smart-store/artisan
#
# ON A LOCAL MACHINE, anywhere you like — they only have to exist and be
# writable, and the shop system has to be checked out somewhere:
#   PANEL_SHOPS_HOME=/home/you/shops
#   PANEL_SHOPS_PUBLIC=/home/you/public_html
#   PANEL_SHARED_ARTISAN=/home/you/systemmanagment/artisan

PANEL_SHOPS_HOME=/home/soransto/shops
PANEL_SHOPS_PUBLIC=/home/soransto/public_html
PANEL_SHARED_ARTISAN=/home/soransto/smart-store/artisan

# ---------------------------------------------------------------------------
# Making a new shop's database
# ---------------------------------------------------------------------------
# Section 4: on the real cPanel account plain `CREATE DATABASE` is DENIED, and
# the way through is UAPI. On a local machine there is no UAPI and SQL is all
# there is. So this is a setting, and it differs between the two.
#
# ON THE SERVER
#   PANEL_DATABASE_MAKER=cpanel
#   PANEL_UAPI=/usr/bin/uapi
#   PANEL_CPANEL_PREFIX=soransto     # cPanel prefixes every database and user
#
# ON A LOCAL MACHINE
#   PANEL_DATABASE_MAKER=direct
#   PANEL_DATABASE_MAKER_CONNECTION=maker
#   PANEL_MAKER_USERNAME=…           # an account that may CREATE DATABASE —
#   PANEL_MAKER_PASSWORD=…           # deliberately NOT the panel's own user

PANEL_DATABASE_MAKER=cpanel
PANEL_UAPI=/usr/bin/uapi
PANEL_CPANEL_PREFIX=

PANEL_DATABASE_MAKER_CONNECTION=maker
PANEL_MAKER_HOST=127.0.0.1
PANEL_MAKER_PORT=3306
PANEL_MAKER_USERNAME=
PANEL_MAKER_PASSWORD=
